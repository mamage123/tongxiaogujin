# 通晓古今 · 环境变量样例
# 复制为 .env 后按需修改；本地开发可只设前三四项。
# 金额字段一律用「厘」（1 元 = 1000 厘），禁止小数。

# ---------------- 基础
APP_ENV=dev                       # dev / prod；prod 下会关闭 /api/docs
APP_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000

# ---------------- 数据与存储
DATABASE_URL=sqlite:///data/app.db
STORAGE_DIR=data/files            # 原图、页面、导出文件都放这里

# ---------------- 管理员（首次启动创建，之后不再读取）
# 不设此变量 = 不创建管理员账号（不提供默认密码）
ADMIN_INIT_USER=admin
ADMIN_INIT_PWD=

# ---------------- OCR 供应商
# OCR_MOCK=1 时完全不联网，用内置 mock 跑通全链路（开发/测试/演示）
OCR_MOCK=0
OCR_PRIMARY=xinghe
OCR_FALLBACK=glm

# 主通道：星河 PaddleOCR-VL（带坐标，可出框层）
# 这是**异步 Job** 接口：提交 → 轮询 → 下载 JSONL 结果
AISTUDIO_ENDPOINT=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
AISTUDIO_TOKEN=
AISTUDIO_MODEL=PaddleOCR-VL-1.6

# 异步任务轮询间隔与整任务超时（30 页实测约 25 秒，单页 3~8 秒）
AISTUDIO_POLL_INTERVAL_S=1.5
AISTUDIO_JOB_TIMEOUT_S=300

# 预处理开关。默认全关——开了 ORIENTATION / UNWARPING 会改变坐标基准，
# 校对版框层相对本地原图会整体偏移（见 app/services/ocr/xinghe.py 模块头「坑 3」）
AISTUDIO_USE_ORIENTATION=0
AISTUDIO_USE_UNWARPING=0
AISTUDIO_USE_CHART=0

# 降级通道：GLM-OCR（只给 Markdown，无坐标 → 框层自动隐藏）
GLM_API_KEY=
GLM_MODEL=glm-ocr
GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions

OCR_TIMEOUT_S=120

# ---------------- 业务上限
MAX_UPLOAD_MB=500
MAX_PAGES=200
MAX_PAGES_LOW_BALANCE=10          # 余额 ≤ LOW_BALANCE_MILL 时单次页数上限
LOW_BALANCE_MILL=1000             # ¥1
CIRCUIT_BREAK_RATIO=1.5           # 实际字数 > 预估 × 1.5 时熔断
FILE_TTL_HOURS=72
SESSION_DAYS=7
COOKIE_SECURE=false               # 会话 Cookie 是否打 Secure 标志；仅上 HTTPS 后设 true，HTTP 阶段必须 false
DUP_WINDOW_SECONDS=60             # 同文件重复提交去重窗口

# ---------------- 计费（可被后台 settings 表覆盖）
PRICE_PER_10K_MILL=1000           # ¥1 / 万字
MIN_BILL_CHARS=1000               # 不足 1000 字按 1000 字计费
FREE_PAGES_DEFAULT=5              # 新账号免费页数

# ---------------- 字体与导出
FONT_DIR=fonts
# PLAYWRIGHT_CHROMIUM_PATH=       # 自定义 Chromium 路径（可选）
EXPORT_MAX_SYNC_PAGES=10

# ---------------- 风控
DEVICE_ACCOUNT_LIMIT=2            # 同设备 24h 内第 3 个账号起不发免费额度
IP_ACCOUNT_LIMIT=5                # 同 IP 24h 内第 6 个账号起不发免费额度

# ---------------- Worker
# 1 = 在 Web 进程内起一个后台线程（单机/开发用）
# 生产建议独立进程：python -m app.worker
RUN_WORKER_INPROC=0

# ---------------- Cloudflare Tunnel（NAS/家宽部署时用）
# 走主动出站连接，所以没有公网 IP、IP 天天变都能用，也不需要公网端口映射。
# 创建：Cloudflare 控制台 → Zero Trust → Networks → Tunnels → Create a tunnel
# 拿到 eyJ... 开头的 token 填这里，然后：docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# 注意：Cloudflare 免费版单次请求上限 100MB。
# 本项无需调整 —— 上传接口是 4MB 一片的分片上传（app/routers/upload.py:CHUNK_SIZE），
# 单个请求远低于限额，大文件靠多片拼装。

